include README.md CHANGELOG.md AGENTS.md CLAUDE.md pyrightconfig.json
recursive-include docs *.md
recursive-include .github/workflows *.yml
recursive-include assets *.md *.png *.html *.pdf *.sh *.txt
recursive-include scripts *.sh *.py *.json *.md *.txt *.toml *.ts
recursive-exclude * __pycache__ *.py[cod]
recursive-include examples *.sh *.py *.json *.toml *.md *.yaml *.yml
prune archive
prune tests


recursive-include evoab/envs *.toml
recursive-include evoab/servers *.toml
